{
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "bundler",
        "module": "esnext",
        "types": ["node"],
        "declaration": true,
        "noLib": false,
        "sourceMap": false,
        "pretty": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "strict": true,
        "noImplicitAny": true,
        "rootDir": "./",
        "allowJs": true,
        "paths": {
            "@/*": ["./src/*"],
            "@test/*": ["./test/*"]
        }
    },
    "tsc-alias": {
        "resolveFullPaths": true
    },
    "include": ["./src", "./test"],
    "compileOnSave": false
}
