{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // 本文件在仓库根，paths 相对本文件解析；@minecraft/* 重定向到本渠道安装的类型。
        // dts 插件的输出 rootDir 在各自 rolldown.config.ts 里通过 compilerOptions.rootDir 显式指定（对齐 preserveModulesRoot）
        "paths": {
            "@/*": ["./core/src/*"],
            "@minecraft/server": [
                "./variants/stable/node_modules/@minecraft/server/index.d.ts"
            ],
            "@minecraft/server-ui": [
                "./variants/stable/node_modules/@minecraft/server-ui/index.d.ts"
            ]
        }
    },
    "include": ["./core/src"]
}